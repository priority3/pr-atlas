{
  "name": "@pr-atlas/cli",
  "version": "0.2.0",
  "type": "module",
  "description": "atlas - a connector-driven personal memory collection CLI.",
  "keywords": [
    "pr-atlas",
    "atlas",
    "cli",
    "connector",
    "personal-knowledge"
  ],
  "license": "MIT",
  "author": "priority3",
  "homepage": "https://github.com/priority3/pr-atlas#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/priority3/pr-atlas.git",
    "directory": "apps/cli"
  },
  "bugs": {
    "url": "https://github.com/priority3/pr-atlas/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "bin": {
    "atlas": "./dist/main.js"
  },
  "files": [
    "dist",
    "src",
    "!dist/**/*.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "tsx --conditions=development --test test/**/*.test.ts",
    "atlas": "tsx --conditions=development src/main.ts"
  },
  "dependencies": {
    "@pr-atlas/connectors": "workspace:*",
    "@pr-atlas/core": "workspace:*",
    "@pr-atlas/schema": "workspace:*"
  }
}
