{
  "name": "@pr-lore/core",
  "version": "0.2.0",
  "type": "module",
  "description": "pr-lore runtime: connector registry, directory-backed outbox, and deliverers.",
  "keywords": [
    "pr-lore",
    "connector",
    "outbox",
    "capture",
    "runtime"
  ],
  "license": "MIT",
  "author": "priority3",
  "homepage": "https://github.com/priority3/pr-lore#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/priority3/pr-lore.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/priority3/pr-lore/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!dist/**/*.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "tsx --conditions=development --test test/**/*.test.ts"
  },
  "dependencies": {
    "@pr-lore/schema": "workspace:*"
  }
}
